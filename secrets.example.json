{
  "_комментарий": [
    "Настройки развёртывания. В прошивку не попадают: scripts/provision.py записывает их",
    "в NVS устройства по USB. Скопируйте в secrets.json (он в .gitignore) и заполните.",
    "Раздел common — общее для всех устройств, в devices можно переопределить любое поле.",
    "Ключи каналов — base64 от 16 байт; пустой ключ означает автоключ по имени канала."
  ],
  "common": {
    "wifi_ssid": "MyNetwork",
    "wifi_pass": "",
    "mqtt_host": "192.168.1.10",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_pass": "",
    "prv_name": "#private",
    "prv_key": "",
    "sns_name": "#sensors",
    "sns_key": "",
    "tx_ch": "#connections",
    "lora_freq": 868.731018,
    "lora_bw": 62.5,
    "lora_sf": 8,
    "lora_cr": 7,
    "lora_tx": 10,
    "lora_pre": 16,
    "lora_sync": "0x12",
    "tz": 3,
    "disp_bri": 255
  },
  "devices": {
    "meshbot": {
      "role": "bot",
      "env": "heltec_v3_coordinator",
      "vext_on": 0
    },
    "sensor1": {
      "role": "sensor",
      "env": "heltec_v4_3_sensors",
      "vext_on": 0
    },
    "sensor2": {
      "role": "sensor",
      "env": "heltec_v4_3_sensors",
      "port": "/dev/ttyACM1",
      "vext_on": 0
    }
  }
}
